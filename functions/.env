# Non-secret settings for the Boxes functions. Safe to commit.
# The two secrets (SQUARE_ACCESS_TOKEN, SQUARE_WEBHOOK_SIGNATURE_KEY) are set
# with `firebase functions:secrets:set` and never live in this file.

# Square SANDBOX values. Replace all four for production (docs/PAID-LAUNCH.md).
SQUARE_ENVIRONMENT=sandbox
SQUARE_LOCATION_ID=LVSKN9DAW9PFA
SQUARE_PLAN_MONTHLY=7EA7DS62H5K5XLXUWFAVXH2Z
SQUARE_PLAN_YEARLY=AX67QUJV723VV736NXY34HYA

# Must be exactly the URL registered for the webhook in Square.
SQUARE_WEBHOOK_URL=https://us-central1-boxes-ffa31.cloudfunctions.net/squareWebhook

# Amplitude project API key for Boxes. Empty = no server-side analytics.
AMPLITUDE_API_KEY=
