{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "package.json",
      "package-lock.json",
      "**/.*",
      "**/node_modules/**",
      "docs/**",
      "functions/**",
      "mcp-server/**",
      "tests/**"
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  },
  "functions": {
    "source": "functions"
  },
  "emulators": {
    "firestore": { "port": 8080 },
    "singleProjectMode": true
  }
}
